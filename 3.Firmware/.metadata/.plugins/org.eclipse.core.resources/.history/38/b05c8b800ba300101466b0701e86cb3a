void display_DisplayNext()
{
	if(disp_cnt ==0)
		disp_cnt = 1;

	display_DisableAll();
	display_WriteBus(display_data[disp_cnt-1]);
	display_EnableDisplay(disp_cnt);

	disp_cnt ++;

	if(disp_cnt>5)
		disp_cnt = 1;
}

/* ###################################################################
 * Function:
 * Author: Moraes, L.
 * Date: Oct 6, 2025
 * Revision: 1.0
 * --------------------
 * Initialize struct of current sensor, calculating it's parameters
 *
 *  arg1: input arg1
 *
 *  arg2: input arg2
 *
 *  returns: void
 *
 *
###################################################################*/
void display_PrepareData(float voltage, float current)
{	
	uint8_t vd1 = 0;
	uint8_t vd2 = 0;	
	uint8_t vd3 = 0;
	uint8_t vd4 = 0;
	uint8_t cd1 = 0;
	uint8_t cd2 = 0;	
	uint8_t cd3 = 0;
	uint8_t cd4 = 0;
	uint16_t voltage_int = 0;
	uint16_t current_int = 0;

	// Limita os valores
    if (voltage > 32.0f) voltage = 32.0f;
    if (voltage < 0.0f) voltage = 0.0f;
    if (current > 9.999f) current = 9.999f;
    if (current < 0.0f) current = 0.0f;

	if (voltage < 10.0f) 
	{
        // Exibe X.XXX (ex: 9.876)
 		voltage_int = (uint16_t)(roundf(voltage * 1000)); // Convert to integer
    } 
	else 
	{
        // Exibe XX.XX (ex: 9.876)
 		voltage_int = (uint16_t)(roundf(voltage * 100)); // Convert to integer
    }

 	current_int = (uint16_t)(roundf(current * 1000)); // Convert to integer
	
	// Extract digits
	vd1 = (voltage_int / 1000) % 10;
	vd2 = (voltage_int / 100) % 10;
	vd3 = (voltage_int / 10) % 10;
	vd4 = voltage_int % 10;
	
	// Extract digits
	cd1 = (current_int / 1000) % 10;
	cd2 = (current_int / 100) % 10;
	cd3 = (current_int / 10) % 10;
	cd4 = current_int % 10;
	
	if (voltage < 10.0f) 
	{
        display_SetNumberOnMemory(vd1, 1, cd1, 1, 1);
		display_SetNumberOnMemory(vd2, 0, cd2, 0, 2);
		display_SetNumberOnMemory(vd3, 0, cd3, 0, 3);
		display_SetNumberOnMemory(vd4, 0, cd4, 0, 4);
    } 
	else 
	{
        display_SetNumberOnMemory(vd1, 0, cd1, 1, 1);
		display_SetNumberOnMemory(vd2, 1, cd2, 0, 2);
		display_SetNumberOnMemory(vd3, 0, cd3, 0, 3);
		display_SetNumberOnMemory(vd4, 0, cd4, 0, 4);
    }
}

