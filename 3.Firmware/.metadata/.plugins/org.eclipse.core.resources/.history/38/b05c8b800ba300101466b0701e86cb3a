###################################################################*/
void display_SetNumberOnMemory(uint8_t bus_high, uint8_t dot_high, uint8_t bus_low, uint8_t dot_low, uint8_t display)
{
	uint16_t dataH = display_GetNumberData(bus_high);
	uint16_t dataL = display_GetNumberData(bus_low);

	if(dot_high)
	{
		dataH |= 0x04;
	}

	if(dot_low)
	{
		dataL |= 0x04;
	}

	uint16_t data = (dataH << 8 ) | dataL;

	if(display == 1)
	{
		display_data[1] = data;
	}

	if(display == 2)
	{
		display_data[0] = data;
	}

	if(display == 3)
	{
		display_data[3] = data;
	}

	if(display == 4)
	{
		display_data[4] = data;
	}
}
