org.eclipse.cdt.ui.text.custom_code_templates=<?xml version\="1.0" encoding\="UTF-8" standalone\="no"?><templates><template autoinsert\="false" context\="org.eclipse.cdt.ui.text.codetemplates.filecomment_context" deleted\="false" description\="Comment for created C/C++ files" enabled\="true" id\="org.eclipse.cdt.ui.text.codetemplates.filecomment" name\="filecomment">/* \#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\r\n**     Filename    \: ${file_base}.\r\n**     Project     \: ${project_name}\r\n**     Processor   \: \r\n**     Version     \: Driver 01.00\r\n**     Compiler    \: GNU C Compiler\r\n**     Date/Time   \: ${date}, ${time}\r\n**     Abstract    \:\r\n**     Author\t   \: ${user}\r\n**\r\n**         This module contains user's application code.\r\n**     Settings    \:\r\n**     Contents    \:\r\n**         No public methods\r\n**\r\n** \#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#*/\r\n</template><template autoinsert\="false" context\="org.eclipse.cdt.core.cHeader.contenttype_context" deleted\="false" description\="" enabled\="true" name\="Lucas C Header template">${filecomment}\r\n\r\n\#ifndef ${include_guard_symbol}\r\n\#define ${include_guard_symbol}\r\n\r\n//--------------------------------------------------------------------\r\n// Includes\r\n//--------------------------------------------------------------------\r\n\r\n${includes}\r\n\r\n\r\n//--------------------------------------------------------------------\r\n// Definitions\r\n//--------------------------------------------------------------------\r\n${declarations}\r\n\r\n//--------------------------------------------------------------------\r\n// Typedef enum\r\n//--------------------------------------------------------------------\r\n\r\n//--------------------------------------------------------------------\r\n// Typedef structs\r\n//--------------------------------------------------------------------\r\n\r\n\r\n//--------------------------------------------------------------------\r\n// Function prototype\r\n//--------------------------------------------------------------------\r\n\r\n\r\n//--------------------------------------------------------------------\r\n// General Variables\r\n//--------------------------------------------------------------------\r\n\r\n\r\n\#endif /* ${include_guard_symbol} */</template><template autoinsert\="false" context\="org.eclipse.cdt.core.cSource.contenttype_context" deleted\="false" description\="Lucas c file source template" enabled\="true" name\="Lucas C source Template">${filecomment}&\#13;\r\n&\#13;\r\n//--------------------------------------------------------------------&\#13;\r\n// Includes&\#13;\r\n//--------------------------------------------------------------------&\#13;\r\n&\#13;\r\n\#include "${file_base}.h"&\#13;\r\n&\#13;\r\n//--------------------------------------------------------------------&\#13;\r\n// Definitions&\#13;\r\n//--------------------------------------------------------------------&\#13;\r\n&\#13;\r\n&\#13;\r\n//--------------------------------------------------------------------&\#13;\r\n// Function prototype&\#13;\r\n//--------------------------------------------------------------------&\#13;\r\n&\#13;\r\n&\#13;\r\n//--------------------------------------------------------------------&\#13;\r\n// Variables&\#13;\r\n//--------------------------------------------------------------------&\#13;\r\n&\#13;\r\n&\#13;\r\n//--------------------------------------------------------------------&\#13;\r\n// Code&\#13;\r\n//--------------------------------------------------------------------&\#13;\r\n&\#13;\r\n/* \#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#&\#13;\r\n * Function\:  &\#13;\r\n * Author\: Moraes, L.&\#13;\r\n * Date\: ${date}&\#13;\r\n * Revision\: 1.0 &\#13;\r\n * --------------------&\#13;\r\n * Initialize struct of current sensor, calculating it's parameters&\#13;\r\n *&\#13;\r\n *  arg1\: input arg1&\#13;\r\n *  &\#13;\r\n *  arg2\: input arg2&\#13;\r\n *&\#13;\r\n *  returns\: void &\#13;\r\n *  \t\t&\#13;\r\n *\t&\#13;\r\n\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#\#*/&\#13;\r\nvoid ${file_base}_Init(void arg1, void arg2)&\#13;\r\n{&\#13;\r\n&\#13;\r\n}</template></templates>
